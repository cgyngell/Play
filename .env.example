# Slate CRM connection
# Your institution's Slate base URL (no trailing slash)
SLATE_BASE_URL=https://yourinstitution.technolutions.net

# Slate service account credentials (use a dedicated API/service user)
SLATE_USERNAME=api_service_user
SLATE_PASSWORD=your_slate_password

# Anthropic API key for Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: server port (default 3001)
PORT=3001

# Optional: allowed CORS origin for the front-end (default http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
